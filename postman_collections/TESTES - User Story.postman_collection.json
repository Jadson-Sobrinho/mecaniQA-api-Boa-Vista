    },
    {
      "name": "Pedidos, itens e vínculos — OAT 2/3",
      "item": [
        {
          "name": "1 - Criar peça",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pecas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro\",\n  \"codigoBarras\": \"7890001\",\n  \"fornecedorMarca\": \"Marca\",\n  \"quantidadeEstoque\": 10,\n  \"precoCusto\": 15.5,\n  \"precoVenda\": 25.9,\n  \"categoria\": \"MOTOR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"pecaId\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Criar serviço",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/servicos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Troca de óleo\",\n  \"tempoEstimado\": 60,\n  \"custoTabelado\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"servicoId\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - Criar ordem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordens-servico",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Revisão\",\n  \"status\": \"ABERTO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"ordemId\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.1 - Alterar status da ordem",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordens-servico/{{ordemId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Revisão em andamento\",\n  \"status\": \"EXECUCAO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Criar pedido vazio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos-pecas",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "5 - Adicionar item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos-pecas/{{pedidoId}}/itens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaCodigo\": \"{{pecaId}}\",\n  \"quantidade\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 - Consultar pedido (repetir após reiniciar API)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos-pecas/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Item persistido\", () => pm.expect(pm.response.json().itens.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "7 - Excluir peça vinculada deve falhar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/pecas/{{pecaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "8 - Alterar status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos-pecas/{{pedidoId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAGO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "9 - Pedido pago recusa item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos-pecas/{{pedidoId}}/itens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaCodigo\": \"{{pecaId}}\",\n  \"quantidade\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
