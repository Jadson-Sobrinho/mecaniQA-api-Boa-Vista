{
  "info": {
    "name": "TESTES - User Story — atualizado para OAT 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute a coleção em ordem. CRUD de peças e serviços usa registros separados do fluxo de pedidos. IDs são capturados das respostas; não pressupõe banco vazio. O fluxo de pedidos mantém dados para verificar persistência após reinício."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "pecaId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "ordemId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "crudPecaId",
      "value": ""
    },
    {
      "key": "crudServicoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CRUD completo — Peça",
      "item": [
        {
          "name": "Cadastrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pecas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro CRUD\",\n  \"codigoBarras\": \"789123\",\n  \"fornecedorMarca\": \"Marca\",\n  \"quantidadeEstoque\": 5,\n  \"precoCusto\": 10,\n  \"precoVenda\": 20,\n  \"categoria\": \"MOTOR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"crudPecaId\", pm.response.json().codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pecas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pelo código retornado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pecas/{{crudPecaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pecas/{{crudPecaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro CRUD atualizado\",\n  \"codigoBarras\": \"789123\",\n  \"fornecedorMarca\": \"Marca\",\n  \"quantidadeEstoque\": 5,\n  \"precoCusto\": 10,\n  \"precoVenda\": 20,\n  \"categoria\": \"MOTOR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir registro sem vínculos",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/pecas/{{crudPecaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar exclusão",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pecas/{{crudPecaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
